{
  "name": "passport-hytale",
  "version": "0.1.0",
  "description": "Sign in with Hytale (OpenID Connect) authentication strategy for Passport.",
  "keywords": [
    "passport",
    "hytale",
    "auth",
    "authn",
    "authentication",
    "identity",
    "oauth2",
    "openid",
    "openidconnect",
    "oidc",
    "pkce"
  ],
  "author": "laspi94",
  "license": "MIT",
  "homepage": "https://github.com/laspi94/passport-hytale#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laspi94/passport-hytale.git"
  },
  "bugs": {
    "url": "https://github.com/laspi94/passport-hytale/issues"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "mocha --require test/bootstrap/node \"test/**/*.test.js\"",
    "test:types": "tsc -p test/types && tsc -p test/types/tsconfig.interop.json && tsc -p test/types/nodenext",
    "coverage": "c8 --reporter=text --reporter=lcov npm test"
  },
  "dependencies": {
    "@types/express": "*",
    "@types/passport": "*",
    "@types/passport-oauth2": "^1.8.0",
    "passport-oauth2": "^1.8.0"
  },
  "devDependencies": {
    "@types/passport-oauth2-refresh": "^1.1.4",
    "c8": "^12.0.0",
    "chai": "^4.5.0",
    "chai-passport-strategy": "^3.0.0",
    "mocha": "^12.0.3",
    "passport-oauth2-refresh": "^2.2.0",
    "typescript": "^5.9.3"
  }
}
